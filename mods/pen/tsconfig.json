{
    "compilerOptions": {
        "target": "ES2025",
        "lib": ["ES2025", "WebWorker", "DOM"],
        "module": "esnext",
        "moduleResolution": "bundler",
        "strict": true,
        "skipLibCheck": true,
        "noEmit": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "jsx": "react-jsx",
        "jsxImportSource": "ubichill",
        // mod が import してよいのは公開パッケージ `ubichill` だけ。参照先も npm に出るビルド済み
        // 成果物 (dist-npm) に向けることで、外部の mod 作者とまったく同じ型で検査される
        // (SDK のソースを見ると、公開 d.ts には現れない内部依存まで解決できてしまう)。
        // 事前に `pnpm build:sdk` が必要。
        "paths": {
            "@/*": ["./src/*"],
            "ubichill": ["../../packages/sdk/dist-npm"],
            "ubichill/*": ["../../packages/sdk/dist-npm/*"]
        }
    },
    "include": ["src/**/*.ts", "src/**/*.tsx"],
    "exclude": ["node_modules"]
}
