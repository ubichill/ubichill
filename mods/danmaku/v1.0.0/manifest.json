{
  "id": "danmaku",
  "name": "danmaku",
  "version": "1.0.0",
  "components": {
    "danmaku:canvas": {
      "canvasTargets": [
        "field"
      ],
      "watchScope": "world",
      "watchEntityTypes": [
        "core:collider"
      ],
      "defaultTransform": {
        "z": 5000
      },
      "description": "自機が撃った弾を Canvas2D で描画する。",
      "capabilities": [
        "canvas:draw",
        "event:emit",
        "scene:read"
      ],
      "workerUrl": "./canvas/index.0a8d1c33.js"
    },
    "danmaku:player": {
      "watchScope": "world",
      "watchEntityTypes": [
        "core:collider"
      ],
      "defaultTransform": {
        "z": 10,
        "w": 32,
        "h": 32
      },
      "dataFields": {
        "speed": {
          "type": "number",
          "default": 160,
          "min": 20,
          "max": 600,
          "step": 10,
          "label": "移動速度 (px/秒)"
        },
        "fireRate": {
          "type": "number",
          "default": 6,
          "min": 1,
          "max": 30,
          "step": 1,
          "label": "発射レート (発/秒)"
        },
        "bulletSpeed": {
          "type": "number",
          "default": 320,
          "min": 50,
          "max": 1000,
          "step": 10,
          "label": "弾速 (px/秒)"
        },
        "autoFire": {
          "type": "boolean",
          "default": false,
          "label": "自動連射"
        }
      },
      "description": "クリックで搭乗。矢印キーで移動し、Zキー（または自動）で射撃、Escapeで降りる自機。",
      "capabilities": [
        "event:emit",
        "scene:read",
        "scene:update",
        "ui:render"
      ],
      "workerUrl": "./player/index.33fe5de7.js"
    },
    "danmaku:wall": {
      "description": "core:collider と同じEntityに置く、弾幕ワールドの壁の見た目。",
      "capabilities": [
        "ui:render"
      ],
      "workerUrl": "./wall/index.8074af9d.js"
    }
  },
  "assets": []
}