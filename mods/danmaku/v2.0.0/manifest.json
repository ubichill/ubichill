{
  "id": "danmaku",
  "name": "danmaku",
  "version": "2.0.0",
  "components": {
    "danmaku:canvas": {
      "canvasTargets": [
        "field"
      ],
      "watchScope": "world",
      "watchEntityTypes": [
        "danmaku:canvas",
        "danmaku:enemy",
        "danmaku:player"
      ],
      "defaultTransform": {
        "z": 5000,
        "w": 800,
        "h": 600
      },
      "description": "遊ぶ範囲。中に置いた敵（danmaku:enemy）が時間どおりに現れて弾を撃つ。自機はこの範囲から出られない。全部倒すか去ると次のラウンドが始まる。",
      "thumbnail": "previews/canvas.svg",
      "capabilities": [
        "canvas:draw",
        "event:emit",
        "scene:read",
        "scene:update",
        "ui:render"
      ],
      "workerUrl": "./canvas/index.dac5d253.js"
    },
    "danmaku:enemy": {
      "dataOnly": true,
      "defaultTransform": {
        "z": 20,
        "w": 40,
        "h": 40
      },
      "thumbnail": "previews/enemy.svg",
      "description": "弾幕の敵。遊ぶ範囲（danmaku:canvas）の中に置く。ラウンドが始まってから現れるまでの秒・去るまでの秒・動き方・弾の撃ち方を決める。",
      "dataFields": {
        "hp": {
          "type": "number",
          "default": 20,
          "min": 1,
          "max": 999,
          "step": 1,
          "label": "HP",
          "help": "自機の弾 1 発で 1 減る"
        },
        "appearAt": {
          "type": "number",
          "default": 0,
          "min": 0,
          "max": 3600,
          "step": 0.5,
          "label": "現れる (秒)",
          "help": "ラウンドが始まってから、上から降りてくるまでの秒"
        },
        "leaveAt": {
          "type": "number",
          "default": 0,
          "min": 0,
          "max": 3600,
          "step": 0.5,
          "label": "去る (秒)",
          "help": "ラウンドが始まってから、上へ去るまでの秒。0 なら倒されるまで居続ける"
        },
        "motion": {
          "type": "enum",
          "default": "sway",
          "options": [
            "none",
            "sway",
            "circle"
          ],
          "label": "動き",
          "help": "none は止まる、sway は左右に揺れる、circle は円を描く"
        },
        "range": {
          "type": "number",
          "default": 80,
          "min": 0,
          "max": 400,
          "step": 10,
          "label": "動く幅 (px)"
        },
        "period": {
          "type": "number",
          "default": 4,
          "min": 0.5,
          "max": 60,
          "step": 0.5,
          "label": "動きの周期 (秒)"
        },
        "pattern": {
          "type": "enum",
          "default": "radial",
          "options": [
            "radial",
            "spiral",
            "aimed",
            "rain"
          ],
          "label": "撃ち方",
          "help": "radial は全方向の輪、spiral は回る渦、aimed は自機を狙う扇、rain は下へばらまく雨"
        },
        "count": {
          "type": "number",
          "default": 12,
          "min": 1,
          "max": 64,
          "step": 1,
          "label": "1 回の弾の数"
        },
        "interval": {
          "type": "number",
          "default": 1,
          "min": 0.05,
          "max": 10,
          "step": 0.05,
          "label": "撃つ間隔 (秒)"
        },
        "bulletSpeed": {
          "type": "number",
          "default": 120,
          "min": 20,
          "max": 600,
          "step": 10,
          "label": "弾速 (px/秒)"
        },
        "spread": {
          "type": "number",
          "default": 30,
          "min": 0,
          "max": 360,
          "step": 1,
          "label": "角度 (度)",
          "help": "aimed は扇の広さ、rain はばらまく広さ、spiral は 1 回ごとに回る角度"
        },
        "color": {
          "type": "color",
          "default": "#f472b6",
          "label": "色"
        }
      }
    },
    "danmaku:player": {
      "watchScope": "world",
      "watchEntityTypes": [
        "danmaku:player",
        "danmaku:canvas"
      ],
      "defaultTransform": {
        "z": 10,
        "w": 32,
        "h": 32
      },
      "thumbnail": "previews/player.svg",
      "dataFields": {
        "speed": {
          "type": "number",
          "default": 200,
          "min": 20,
          "max": 600,
          "step": 10,
          "label": "移動速度 (px/秒)"
        },
        "fireRate": {
          "type": "number",
          "default": 8,
          "min": 1,
          "max": 30,
          "step": 1,
          "label": "発射レート (発/秒)"
        },
        "bulletSpeed": {
          "type": "number",
          "default": 420,
          "min": 50,
          "max": 1000,
          "step": 10,
          "label": "弾速 (px/秒)"
        },
        "autoFire": {
          "type": "boolean",
          "default": true,
          "label": "自動連射"
        },
        "maxHp": {
          "type": "number",
          "default": 5,
          "min": 1,
          "max": 20,
          "step": 1,
          "label": "HP"
        },
        "invincibleSeconds": {
          "type": "number",
          "default": 2,
          "min": 0,
          "max": 10,
          "step": 0.5,
          "label": "被弾後の無敵 (秒)"
        },
        "respawnSeconds": {
          "type": "number",
          "default": 3,
          "min": 0.5,
          "max": 30,
          "step": 0.5,
          "label": "復活までの時間 (秒)"
        },
        "hitRadius": {
          "type": "number",
          "default": 4,
          "min": 1,
          "max": 16,
          "step": 1,
          "label": "当たり判定の半径 (px)"
        }
      },
      "description": "クリックで搭乗。矢印キーで移動（Shift で低速）、Zキーか自動連射で撃つ。敵の弾に当たると HP が減り、0 で撃墜されて少しあと復活する。Escapeで降りる。",
      "capabilities": [
        "event:broadcast",
        "event:emit",
        "scene:read",
        "scene:update",
        "ui:render"
      ],
      "workerUrl": "./player/index.94ed953e.js"
    }
  },
  "thumbnail": "previews/thumbnail.svg",
  "description": "置いた敵が時間どおりに現れて弾幕を撃つ、シューティングの部品です。自機は HP を持ち、遊ぶ範囲の中で弾をよけながら敵を撃ち落とします。",
  "assets": [
    "previews/canvas.svg",
    "previews/enemy.svg",
    "previews/player.svg",
    "previews/thumbnail.svg"
  ],
  "assetIntegrity": {
    "previews/canvas.svg": "sha256-BjKEd6a6aldlCxG0jg+kUIEdFhOKxt1BqH9IpfM/fCY=",
    "previews/enemy.svg": "sha256-fuUxG/rxGSA/AmcagCPHgiJmmFq7KmQXMACImuvXMKc=",
    "previews/player.svg": "sha256-c2TS7T+AUI2+lgOArk/QbUuQrrAsL99SajFsYAGomqo=",
    "previews/thumbnail.svg": "sha256-Ny2YEjG5B+QIKhWbb9wrBBNuDIwZpKbgzBw2OIs1R1o="
  }
}