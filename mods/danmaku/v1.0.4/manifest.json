{
  "id": "danmaku",
  "name": "danmaku",
  "version": "1.0.4",
  "components": {
    "danmaku:canvas": {
      "canvasTargets": [
        "field"
      ],
      "watchScope": "world",
      "watchEntityTypes": [
        "core:collider"
      ],
      "defaultTransform": {
        "z": 5000
      },
      "description": "自機が撃った弾を Canvas2D で描画する。",
      "thumbnail": "previews/canvas.svg",
      "capabilities": [
        "canvas:draw",
        "event:emit",
        "scene:read"
      ],
      "workerUrl": "./canvas/index.fa1a4cb0.js"
    },
    "danmaku:player": {
      "watchScope": "world",
      "watchEntityTypes": [
        "core:collider"
      ],
      "defaultTransform": {
        "z": 10,
        "w": 32,
        "h": 32
      },
      "thumbnail": "previews/player.svg",
      "dataFields": {
        "speed": {
          "type": "number",
          "default": 160,
          "min": 20,
          "max": 600,
          "step": 10,
          "label": "移動速度 (px/秒)"
        },
        "fireRate": {
          "type": "number",
          "default": 6,
          "min": 1,
          "max": 30,
          "step": 1,
          "label": "発射レート (発/秒)"
        },
        "bulletSpeed": {
          "type": "number",
          "default": 320,
          "min": 50,
          "max": 1000,
          "step": 10,
          "label": "弾速 (px/秒)"
        },
        "autoFire": {
          "type": "boolean",
          "default": false,
          "label": "自動連射"
        }
      },
      "description": "クリックで搭乗。矢印キーで移動し、Zキー（または自動）で射撃、Escapeで降りる自機。",
      "capabilities": [
        "event:emit",
        "scene:read",
        "scene:update",
        "ui:render"
      ],
      "workerUrl": "./player/index.6aa3422b.js"
    },
    "danmaku:wall": {
      "description": "core:collider と同じEntityに置く、弾幕ワールドの壁の見た目。",
      "thumbnail": "previews/wall.svg",
      "capabilities": [
        "ui:render"
      ],
      "workerUrl": "./wall/index.53800c55.js"
    }
  },
  "thumbnail": "previews/thumbnail.svg",
  "description": "矢印キーで自機を動かし、弾を撃ち合う弾幕のサンプルです。",
  "assets": [
    "previews/canvas.svg",
    "previews/player.svg",
    "previews/thumbnail.svg",
    "previews/wall.svg"
  ],
  "assetIntegrity": {
    "previews/canvas.svg": "sha256-s2H/XKW1OvCEw8L8MLsdXDGy8TrsVelDBVPRm4nnf2w=",
    "previews/player.svg": "sha256-doorPFoxl75NpuwcXMG2ZVktM8dULPusV4G+F4syHcA=",
    "previews/thumbnail.svg": "sha256-d9jCGLpVAmfwpDqTo6c545RWkdc/lQB9V1rZNxn2DiM=",
    "previews/wall.svg": "sha256-e/isSQVGiCZWJ5Gdm+9Yt7nF9EnI1eTKwo+d+UND8Dk="
  }
}