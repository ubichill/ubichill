{
  "name": "ubichill",
  "version": "1.0.0",
  "private": true,
  "description": "2D metaverse-style work sharing web application",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@12.6.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.12.1",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:workers": "node packages/cli/src/index.ts build --mods-dir=mods --public-mods-dir=packages/frontend/public/mods --dist-dir=dist/mods && pnpm gen:world-locks",
    "build:sdk": "turbo build --filter=@ubichill/sdk",
    "build:cli": "turbo build --filter=@ubichill/cli",
    "build:instance": "turbo build --filter=@ubichill/instance",
    "gen:install": "node packages/cli/src/index.ts install --mods-dir=packages/frontend/public/mods",
    "gen:world-locks": "node scripts/world-locks.mjs",
    "mods:restore": "git fetch --depth=1 origin gh-pages:refs/remotes/origin/gh-pages && rm -rf .published-mods && mkdir -p .published-mods && git archive origin/gh-pages mods | tar -x -C .published-mods && node scripts/restore-published-mods.mjs .published-mods/mods packages/frontend/public/mods && rm -rf .published-mods",
    "gen:emoji": "node scripts/generate-emoji-data.mjs",
    "verify:mod-locks": "node packages/cli/src/index.ts verify --dist-dir=dist/mods",
    "verify:world-locks": "node scripts/world-locks.mjs --check",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:migrations": "node scripts/check-migrations.mjs",
    "check:chart": "node scripts/check-chart.mjs",
    "check:loadtest-chart": "node scripts/check-loadtest-chart.mjs",
    "verify:sdk-types": "vitest run --config vitest.sdk-verify.config.ts",
    "docs:capabilities": "node scripts/gen-capability-docs.mjs",
    "build": "turbo build --filter=@ubichill/shared && pnpm build:workers && turbo build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "turbo typecheck",
    "db:generate": "pnpm --filter @ubichill/db generate",
    "db:migrate": "pnpm --filter @ubichill/db migrate:dev",
    "clean": "pnpm --filter \"./packages/*\" clean",
    "test": "vitest run",
    "smoke": "pnpm --filter @ubichill/e2e smoke",
    "test:watch": "vitest",
    "instance:dev": "go -C services/instance run ./cmd/instance --guests --world=examples/empty.json --origins=http://localhost:3000",
    "instance:test": "go -C services/instance test -race ./...",
    "protocol:generate": "node scripts/generate-instance-protocol.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@changesets/cli": "^2.31.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "catalog:",
    "@ubichill/terminal": "workspace:*",
    "concurrently": "^9.2.4",
    "cross-env": "^10.1.0",
    "esbuild": "catalog:",
    "jsdom": "^29.1.1",
    "kill-port": "^2.0.1",
    "nodemon": "catalog:",
    "turbo": "^2.11.3",
    "typescript": "catalog:",
    "vitest": "^4.1.11",
    "yaml": "catalog:"
  }
}
