{
  "name": "ubichill",
  "version": "1.0.0",
  "private": true,
  "description": "2D metaverse-style work sharing web application",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:workers": "node packages/sdk/cli/index.ts build --mods-dir=mods --public-mods-dir=packages/frontend/public/mods --dist-dir=dist/mods",
    "build:sdk": "pnpm --filter @ubichill/sdk build",
    "gen:install": "node packages/sdk/cli/index.ts install --mods-dir=packages/frontend/public/mods",
    "verify:mod-locks": "node packages/sdk/cli/index.ts verify --dist-dir=dist/mods",
    "verify:world-locks": "node scripts/check-world-locks.mjs",
    "verify:sdk-types": "vitest run --config vitest.sdk-verify.config.ts",
    "docs:capabilities": "node scripts/gen-capability-docs.mjs",
    "build": "pnpm --filter @ubichill/shared build && pnpm build:workers && turbo build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "pnpm -r --parallel exec tsc --noEmit",
    "db:generate": "pnpm --filter @ubichill/db generate",
    "db:migrate": "pnpm --filter @ubichill/db migrate:dev",
    "clean": "pnpm --filter \"./packages/*\" clean",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "volta": {
    "node": "25.9.0",
    "pnpm": "10.33.2"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "0.28.0",
      "react": "^19.2.5",
      "react-dom": "^19.2.5",
      "dts-bundle-generator>typescript": "^5.9.0"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "dependencies": {
    "@ubichill/shared": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.13",
    "@changesets/cli": "^2.31.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.13.4",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.0",
    "jsdom": "^29.1.1",
    "kill-port": "^2.0.1",
    "nodemon": "^3.1.11",
    "turbo": "^2.8.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
