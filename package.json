{
  "name": "ubichill",
  "version": "1.0.0",
  "private": true,
  "description": "2D metaverse-style work sharing web application",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@12.6.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.10.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:workers": "node packages/sdk/cli/index.ts build --mods-dir=mods --public-mods-dir=packages/frontend/public/mods --dist-dir=dist/mods && pnpm gen:world-locks",
    "build:sdk": "pnpm --filter @ubichill/sdk build",
    "gen:install": "node packages/sdk/cli/index.ts install --mods-dir=packages/frontend/public/mods",
    "gen:world-locks": "node scripts/world-locks.mjs",
    "verify:mod-locks": "node packages/sdk/cli/index.ts verify --dist-dir=dist/mods",
    "verify:world-locks": "node scripts/world-locks.mjs --check",
    "verify:sdk-types": "vitest run --config vitest.sdk-verify.config.ts",
    "docs:capabilities": "node scripts/gen-capability-docs.mjs",
    "build": "pnpm --filter @ubichill/shared build && pnpm build:workers && turbo build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "pnpm -r --parallel exec tsc --noEmit",
    "db:generate": "pnpm --filter @ubichill/db generate",
    "db:migrate": "pnpm --filter @ubichill/db migrate:dev",
    "clean": "pnpm --filter \"./packages/*\" clean",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ubichill/shared": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@changesets/cli": "^2.31.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.2",
    "concurrently": "^9.2.4",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.0",
    "jsdom": "^29.1.1",
    "kill-port": "^2.0.1",
    "nodemon": "^3.1.14",
    "turbo": "^2.11.3",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
