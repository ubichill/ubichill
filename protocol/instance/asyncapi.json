            "data": {
              "type": "object",
              "properties": {
                "entityId": {
                  "type": "string"
                },
                "data": {}
              },
              "required": [
                "entityId",
                "data"
              ],
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "server:notice": {
        "name": "server:notice",
        "summary": "Ephemeral notice (not stored). Clients ignore unknown kinds.",
        "payload": {
          "type": "object",
          "required": [
            "event",
            "data"
          ],
          "properties": {
            "event": {
              "const": "server:notice"
            },
            "data": {
              "oneOf": [
                {
                  "type": "object",
                  "required": [
                    "kind",
                    "at"
                  ],
                  "properties": {
                    "kind": {
                      "const": "disconnect"
                    },
                    "at": {
                      "type": "integer",
                      "minimum": 0,
                      "description": "Epoch milliseconds when the server closes this connection. The client reconnects automatically."
                    }
                  }
                }
              ]
            }
          },
          "additionalProperties": false
        }
      },
