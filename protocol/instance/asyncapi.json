        "payload": {
          "type": "object",
          "required": [
            "event",
            "id",
            "data"
          ],
          "properties": {
            "event": {
              "const": "world:join"
            },
            "id": {
              "type": "string",
              "maxLength": 100
            },
            "data": {
              "type": "object",
              "properties": {
                "instanceId": {
                  "type": "string"
                },
                "token": {
                  "type": "string"
                },
                "user": {
                  "type": "object",
                  "required": [
                    "name",
                    "position",
                    "status"
                  ],
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 30
                    },
                    "position": {
                      "type": "object",
                      "properties": {
                        "x": {
                          "type": "number",
                          "minimum": -10000000.0,
                          "maximum": 10000000.0
                        },
                        "y": {
                          "type": "number",
                          "minimum": -10000000.0,
                          "maximum": 10000000.0
                        }
                      },
                      "required": [
                        "x",
                        "y"
                      ],
                      "additionalProperties": false
                    },
                    "status": {
                      "enum": [
                        "online",
                        "busy",
                        "dnd",
                        "away",
                        "offline"
                      ]
                    }
                  },
                  "additionalProperties": true
                }
              },
              "required": [
                "instanceId",
                "token",
                "user"
              ],
              "additionalProperties": false
            }
          },
          "additionalProperties": false
