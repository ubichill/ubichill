      },
      "reply": {
        "name": "reply",
        "payload": {
          "type": "object",
          "required": [
            "replyTo",
            "data"
          ],
          "properties": {
            "replyTo": {
              "type": "string"
            },
            "data": {
              "type": "object",
              "properties": {
                "success": {
                  "type": "boolean"
                },
                "error": {
                  "type": "string"
                },
                "code": {
                  "type": "string",
                  "enum": [
                    "ticket_invalid",
                    "instance_unavailable",
                    "conflict"
                  ],
                  "description": "ticket_invalid / instance_unavailable: recoverable world:join failure. Refresh the ticket at most once for ticket_invalid; all retries share a finite connection budget. conflict: state:update did not match expectedRevision; entry carries the current value."
                },
                "entry": {
                  "oneOf": [
                    {
                      "$ref": "#/components/messages/state:changed/payload/properties/data"
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "state:get / state:update の応答。キーが無ければ null。"
                },
                "serverTime": {
                  "type": "integer",
                  "format": "int64",
                  "description": "応答を作ったサーバー時刻（epoch ms）。state:get / state:update の応答に付く。"
                }
              }
            }
          },
          "additionalProperties": false
        }
      },
      "state:get": {
        "name": "state:get",
        "payload": {
          "type": "object",
          "required": [
            "event",
            "id",
            "data"
          ],
          "properties": {
            "event": {
              "const": "state:get"
            },
            "id": {
              "type": "string",
              "maxLength": 100
            },
            "data": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512,
                  "description": "UTF-8 で 512 バイト以内。名前空間（mod・メディアのセッションなど）は Host が付け、サーバーは解釈しない。"
                }
              },
              "required": [
                "key"
              ],
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "state:update": {
        "name": "state:update",
        "payload": {
          "type": "object",
          "required": [
            "event",
            "id",
            "data"
          ],
          "properties": {
            "event": {
              "const": "state:update"
            },
            "id": {
              "type": "string",
              "maxLength": 100
            },
            "data": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512,
                  "description": "UTF-8 で 512 バイト以内。名前空間（mod・メディアのセッションなど）は Host が付け、サーバーは解釈しない。"
                },
                "value": {
                  "description": "任意の JSON（詰めた表現で 32KiB 以内）。サーバーは解釈しない。"
                },
                "expectedRevision": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991,
                  "description": "今の revision（無いキーは 0）。一致しなければ書かずに code: conflict と今の entry を返す。"
                }
              },
              "required": [
                "key",
                "value",
                "expectedRevision"
              ],
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "state:changed": {
        "name": "state:changed",
        "payload": {
          "type": "object",
          "required": [
            "event"
          ],
          "properties": {
            "event": {
              "const": "state:changed"
            },
            "id": {
              "type": "string",
              "maxLength": 100
            },
            "data": {
              "type": "object",
              "description": "部屋の共有状態の 1 件。",
              "properties": {
                "key": {
                  "type": "string"
                },
                "value": {
                  "description": "任意の JSON（詰めた表現で 32KiB 以内）。サーバーは解釈しない。"
                },
                "revision": {
                  "type": "integer",
                  "minimum": 1
                },
                "updatedAt": {
                  "type": "integer",
                  "format": "int64",
                  "description": "書き込みを受けたサーバー時刻（epoch ms）"
                },
                "updatedBy": {
                  "type": "string"
                }
              },
              "required": [
                "key",
                "value",
                "revision",
                "updatedAt",
                "updatedBy"
              ],
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      }
    }
  }
