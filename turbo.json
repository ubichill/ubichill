{
    "$schema": "https://turbo.build/schema.json",
    "tasks": {
        "build": {
            "dependsOn": [
                "^build"
            ],
            "outputs": [
                "dist/**"
            ]
        },
        "@ubichill/sdk#build": {
            "dependsOn": [
                "^build"
            ],
            "outputs": [
                "dist-npm/**"
            ]
        },
        "@ubichill/cli#build": {
            "dependsOn": [
                "^build"
            ],
            "outputs": [
                "dist-npm/**"
            ]
        },
        "typecheck": {
            "dependsOn": [
                "^build"
            ],
            "outputs": []
        },
        "dev": {
            "dependsOn": [
                "^build"
            ],
            "cache": false,
            "persistent": true
        },
        "lint": {}
    }
}
