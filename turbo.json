{
    "$schema": "https://turbo.build/schema.json",
    "tasks": {
        "build": {
            "dependsOn": [
                "^build"
            ],
            "outputs": [
                "dist/**"
            ]
        },
        "@ubichill/sdk#build": {
            "dependsOn": [
                "^build",
                "^transit"
            ],
            "outputs": [
                "dist-npm/**"
            ]
        },
        "@ubichill/cli#build": {
            "dependsOn": [
                "^build",
                "^transit",
                "@ubichill/frontend#build:world"
            ],
            "outputs": [
                "dist-npm/**"
            ]
        },
        "@ubichill/frontend#build:world": {
            "dependsOn": [
                "@ubichill/shared#build",
                "^transit"
            ],
            "inputs": [
                "$TURBO_DEFAULT$",
                "$TURBO_ROOT$/scripts/architecture.mjs"
            ],
            "outputs": [
                "dist-world/**"
            ]
        },
        "@ubichill/instance#build": {
            "inputs": [
                "build.mjs",
                "package.json",
                "$TURBO_ROOT$/packages/cli/src/instancePlatforms.ts",
                "$TURBO_ROOT$/services/instance/**",
                "$TURBO_ROOT$/mise.toml"
            ],
            "outputs": [
                "dist-npm/**"
            ]
        },
        "typecheck": {
            "dependsOn": [
                "^build"
            ],
            "outputs": []
        },
        "dev": {
            "dependsOn": [
                "^build"
            ],
            "cache": false,
            "persistent": true
        },
        "lint": {},
        "transit": {
            "dependsOn": [
                "^transit"
            ]
        }
    }
}
