{
    "$schema": "https://turbo.build/schema.json",
    "tasks": {
        "build": {
            "dependsOn": [
                "^build"
            ],
            "outputs": [
                "dist/**"
            ]
        },
        "@ubichill/sdk#build": {
            "dependsOn": [
                "^build"
            ],
            "outputs": [
                "dist-npm/**"
            ]
        },
        "@ubichill/cli#build": {
            "dependsOn": [
                "^build",
                "@ubichill/frontend#build:world"
            ],
            "outputs": [
                "dist-npm/**"
            ]
        },
        "@ubichill/frontend#build:world": {
            "dependsOn": [
                "@ubichill/shared#build"
            ],
            "inputs": [
                "$TURBO_DEFAULT$",
                "../../scripts/architecture.mjs"
            ],
            "outputs": [
                "dist-world/**"
            ]
        },
        "@ubichill/instance#build": {
            "inputs": [
                "build.mjs",
                "package.json",
                "../cli/src/instancePlatforms.ts",
                "../../services/instance/**",
                "../../mise.toml"
            ],
            "outputs": [
                "dist-npm/**"
            ]
        },
        "typecheck": {
            "dependsOn": [
                "^build"
            ],
            "outputs": []
        },
        "dev": {
            "dependsOn": [
                "^build"
            ],
            "cache": false,
            "persistent": true
        },
        "lint": {}
    }
}
