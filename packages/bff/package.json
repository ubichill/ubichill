{
    "name": "@ubichill/bff",
    "version": "1.0.3",
    "private": true,
    "description": "BFF: SPA 配信 + OGP/JSON-LD メタ注入（フロント配信層）。core backend はドメイン API に純化。",
    "main": "dist/index.js",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "tsc",
        "start": "node dist/index.js",
        "clean": "rimraf dist",
        "lint": "biome lint .",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@ubichill/shared": "workspace:*",
        "express": "catalog:"
    },
    "devDependencies": {
        "@types/express": "catalog:",
        "@types/node": "catalog:",
        "rimraf": "catalog:",
        "tsx": "catalog:",
        "typescript": "catalog:"
    }
}
