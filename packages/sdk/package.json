{
    "name": "@ubichill/sdk",
    "version": "2.1.1",
    "description": "ubichill mod SDK (UbiSDK runtime + public API) and CLI (build/lock/verify) for mod developers.",
    "type": "module",
    "sideEffects": false,
    "main": "src/index.ts",
    "types": "src/index.ts",
    "exports": {
        ".": "./src/index.ts",
        "./jsx-runtime": "./src/jsx/jsx-runtime.ts",
        "./gripable": "./src/jsx/Gripable.tsx"
    },
    "dependencies": {
        "@ubichill/core-components": "workspace:*",
        "@ubichill/ecs": "workspace:*",
        "@ubichill/loader": "workspace:*",
        "@ubichill/runtime": "workspace:*",
        "@ubichill/shared": "workspace:*"
    },
    "scripts": {
        "build": "node build.mjs",
        "clean": "rimraf dist-npm",
        "typecheck": "tsc --noEmit"
    },
    "devDependencies": {
        "dts-bundle-generator": "^9.5.1",
        "esbuild": "catalog:",
        "rimraf": "catalog:",
        "typescript": "catalog:"
    }
}
