{
    "extends": "../../tsconfig.bundler.json",
    "compilerOptions": {
        "lib": ["ES2025", "DOM"],
        "allowJs": true,
        "isolatedModules": true,
        "jsx": "react-jsx",
        "paths": {
            "@/*": ["./src/*"],
            "@styled-system/*": ["./styled-system/*"],
            "@styles/*": ["./src/styles/*"],
            "@/styled-system/*": ["./styled-system/*"],
            "@ubichill/sdk": ["../sdk/src/index.ts"],
            "@ubichill/sdk/react": ["../sdk/src/react/index.ts"],
            "@ubichill/ecs": ["../ecs/src/index.ts"],
            "@ubichill/runtime": ["../runtime/src/index.ts"],
            "@ubichill/core-components": ["../core-components/src/index.ts"],
            "@ubichill/core-components/public": ["../core-components/src/public.ts"],
            "@ubichill/sandbox": ["../sandbox/src/index.ts"],
            "@ubichill/ui-renderer": ["../ui-renderer/src/index.ts"],
            "@ubichill/react": ["../react/src/index.ts"],
            "@ubichill/shared": ["../shared/src/index.ts"]
        }
    },
    "include": ["**/*.ts", "**/*.tsx"],
    "exclude": ["node_modules", "dist"]
}
