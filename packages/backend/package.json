{
    "name": "@ubichill/backend",
    "version": "1.0.3",
    "private": true,
    "description": "Backend server for Ubichill",
    "main": "dist/index.js",
    "scripts": {
        "dev": "wait-on ../shared/dist/.build_done && nodemon",
        "build": "tsc",
        "start": "node dist/index.js",
        "clean": "rimraf dist",
        "lint": "biome lint .",
        "lint:fix": "biome lint --apply .",
        "format": "biome format --write ."
    },
    "nodemonConfig": {
        "watch": [
            "src",
            "../shared/dist/.build_done"
        ],
        "ignore": [
            "../shared/dist/**/*.js",
            "../shared/dist/**/*.d.ts",
            "../shared/dist/**/*.map"
        ],
        "ext": "ts,json,done",
        "exec": "tsx src/index.ts"
    },
    "dependencies": {
        "@ubichill/db": "workspace:*",
        "@ubichill/shared": "workspace:*",
        "bcryptjs": "^3.0.3",
        "better-auth": "^1.7.6",
        "cors": "^2.8.6",
        "dotenv": "^17.4.2",
        "drizzle-orm": "^0.45.3",
        "express": "^5.2.1",
        "express-rate-limit": "^8.7.0",
        "helmet": "^8.3.0",
        "nanoid": "^5.1.16",
        "resend": "^6.28.1",
        "socket.io": "^4.8.3",
        "yaml": "^2.9.1",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/node": "^25.9.8",
        "nodemon": "^3.1.14",
        "rimraf": "^6.1.3",
        "tsx": "^4.23.15",
        "wait-on": "^9.1.0"
    }
}
