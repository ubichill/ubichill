{
    "name": "@ubichill/backend",
    "version": "1.13.0",
    "private": true,
    "description": "Backend server for Ubichill",
    "main": "dist/index.js",
    "files": [
        "dist"
    ],
    "scripts": {
        "dev": "wait-on ../shared/dist/.build_done && nodemon",
        "build": "tsc",
        "start": "node dist/index.js",
        "clean": "rimraf dist",
        "lint": "biome lint .",
        "lint:fix": "biome lint --apply .",
        "format": "biome format --write .",
        "typecheck": "tsc --noEmit"
    },
    "nodemonConfig": {
        "watch": [
            "src",
            "../shared/dist/.build_done"
        ],
        "ignore": [
            "../shared/dist/**/*.js",
            "../shared/dist/**/*.d.ts",
            "../shared/dist/**/*.map"
        ],
        "ext": "ts,json,done",
        "exec": "tsx src/index.ts"
    },
    "dependencies": {
        "@redis/client": "^6.3.1",
        "@ubichill/db": "workspace:*",
        "@ubichill/shared": "workspace:*",
        "@ubichill/terminal": "workspace:*",
        "better-auth": "catalog:",
        "cors": "^2.8.6",
        "dotenv": "^18.0.10",
        "drizzle-orm": "catalog:",
        "express": "catalog:",
        "express-rate-limit": "^8.7.4",
        "helmet": "^8.3.0",
        "nanoid": "catalog:",
        "postgres": "^4.1.0",
        "rate-limit-redis": "^6.0.2",
        "resend": "^6.38.0",
        "sharp": "^0.35.5",
        "undici": "^8.12.4",
        "yaml": "catalog:",
        "zod": "catalog:"
    },
    "devDependencies": {
        "@types/cors": "^2.8.19",
        "@types/express": "catalog:",
        "@types/node": "catalog:",
        "nodemon": "catalog:",
        "rimraf": "catalog:",
        "tsx": "catalog:",
        "typescript": "catalog:",
        "wait-on": "^9.1.0"
    }
}
