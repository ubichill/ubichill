{
    "name": "@ubichill/backend",
    "version": "1.0.3",
    "private": true,
    "description": "Backend server for Ubichill",
    "main": "dist/index.js",
    "scripts": {
        "dev": "wait-on ../shared/dist/.build_done && nodemon",
        "build": "tsc",
        "start": "node dist/index.js",
        "clean": "rimraf dist",
        "lint": "biome lint .",
        "lint:fix": "biome lint --apply .",
        "format": "biome format --write ."
    },
    "nodemonConfig": {
        "watch": [
            "src",
            "../shared/dist/.build_done"
        ],
        "ignore": [
            "../shared/dist/**/*.js",
            "../shared/dist/**/*.d.ts",
            "../shared/dist/**/*.map"
        ],
        "ext": "ts,json,done",
        "exec": "tsx src/index.ts"
    },
    "dependencies": {
        "@ubichill/db": "workspace:*",
        "@ubichill/shared": "workspace:*",
        "bcryptjs": "^3.0.3",
        "better-auth": "catalog:",
        "cors": "^2.8.6",
        "dotenv": "^17.4.2",
        "drizzle-orm": "catalog:",
        "express": "catalog:",
        "express-rate-limit": "^8.7.0",
        "helmet": "^8.3.0",
        "nanoid": "catalog:",
        "resend": "^6.28.1",
        "socket.io": "^4.8.3",
        "yaml": "catalog:",
        "zod": "catalog:"
    },
    "devDependencies": {
        "@types/cors": "^2.8.19",
        "@types/express": "catalog:",
        "@types/node": "catalog:",
        "nodemon": "catalog:",
        "rimraf": "catalog:",
        "tsx": "catalog:",
        "typescript": "catalog:",
        "wait-on": "^9.1.0"
    }
}
