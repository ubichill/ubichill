# 環境変数設定

# サーバーポート
PORT=3001

# Node環境 (development, production)
NODE_ENV=development

# CORS設定
# 許可するオリジンのカンマ区切りリスト
# 例:
# - 単一オリジン: http://localhost:3000
# - 複数オリジン: http://localhost:3000,https://app.example.com
# - 全てのオリジン（開発環境のみ）: *
CORS_ORIGIN=http://localhost:3000

# Goインスタンスサーバー（Go側にも同じ管理トークンを設定する）
INSTANCE_RUNTIME_URL=http://127.0.0.1:3002
INSTANCE_PUBLIC_URL=http://localhost:3002/realtime/v1/ws
# 開発専用。公開運用では32文字以上のランダム値に置き換える。
INSTANCE_ADMIN_TOKEN=ubichill-instance-dev-token-change-before-deploy

# レート制限
# ウィンドウ期間（ミリ秒単位、デフォルト: 15分）
RATE_LIMIT_WINDOW_MS=900000

# ウィンドウ期間あたりの最大リクエスト数
RATE_LIMIT_MAX_REQUESTS=100

# デバッグログ出力（true/false）
DEBUG=false

# Database
DATABASE_URL="postgresql://ubichill:password@127.0.0.1:5433/ubichill"
REDIS_URL="redis://127.0.0.1:6379"

# Better Auth
BETTER_AUTH_SECRET="ubichill-dev-secret-change-in-production"
BETTER_AUTH_URL="http://localhost:3001"

# Resend (Email)
RESEND_API_KEY=
SKIP_EMAIL_VERIFICATION=true
