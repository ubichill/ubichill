{
    "name": "@ubichill/terminal",
    "version": "0.0.0",
    "private": true,
    "description": "端末への出力の書式（色・記号・1 行のイベント・バナー・エラー・サーバーのログ）。CLI・scripts・backend・db が共有する。",
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "require": "./dist/index.js",
            "default": "./src/index.ts"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "clean": "rimraf dist",
        "typecheck": "tsc --noEmit"
    },
    "devDependencies": {
        "@types/node": "catalog:",
        "rimraf": "catalog:",
        "typescript": "catalog:"
    }
}
