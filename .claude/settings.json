{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "permissions": {
        "allow": [
            "Bash(pnpm lint)",
            "Bash(pnpm lint:fix)",
            "Bash(pnpm typecheck)",
            "Bash(pnpm test)",
            "Bash(pnpm test *)",
            "Bash(pnpm exec vitest *)",
            "Bash(pnpm check:*)",
            "Bash(pnpm verify:*)",
            "Bash(pnpm build:workers)",
            "Bash(pnpm exec changeset status*)",
            "Bash(pnpm instance:test)",
            "Bash(git status*)",
            "Bash(git diff*)",
            "Bash(git log*)",
            "Bash(git show*)",
            "Bash(git branch)",
            "Bash(git branch --list)",
            "Bash(git branch --merged)",
            "Bash(git branch -d -- *)",
            "Bash(git branch --delete -- *)",
            "Bash(git worktree list*)",
            "Bash(gh pr view*)",
            "Bash(gh pr list*)",
            "Bash(gh pr checks*)",
            "Bash(gh pr diff*)",
            "Bash(gh issue view*)",
            "Bash(gh issue list*)",
            "Bash(gh run view*)",
            "Bash(gh run list*)"
        ],
        "deny": ["Read(./**/.env)", "Read(./**/.env.local)", "Read(./**/.env.*.local)"]
    },
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node \"$CLAUDE_PROJECT_DIR/scripts/agent-hooks/pre-bash.mjs\"",
                        "timeout": 15
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "Edit|Write|MultiEdit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node \"$CLAUDE_PROJECT_DIR/scripts/agent-hooks/post-edit-format.mjs\"",
                        "timeout": 40
                    }
                ]
            }
        ]
    }
}
